#!/usr/bin/env python3
"""Wait until gz has created the simulated Dynamixel ports, or fail after a timeout."""

import argparse
import os
import sys
import time


def created_since(port, start):
    # A gz killed before its cleanup leaves a link to a pty number another terminal may reuse
    try:
        return os.lstat(port).st_mtime >= start
    except FileNotFoundError:
        return False


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--timeout", type=float, default=60.0, help="seconds")
    parser.add_argument("ports", nargs="+")
    args = parser.parse_args()
    # The kernel stamps a link with its coarse clock, up to about a millisecond behind time.time()
    start = time.time() - 0.1
    deadline = time.monotonic() + args.timeout
    print(f"Waiting for {' '.join(args.ports)}", flush=True)
    while not all(created_since(port, start) for port in args.ports):
        if time.monotonic() > deadline:
            missing = [port for port in args.ports if not created_since(port, start)]
            sys.exit(
                f"No simulated Dynamixel port after {args.timeout} s: {' '.join(missing)}"
            )
        time.sleep(0.1)


if __name__ == "__main__":
    main()
