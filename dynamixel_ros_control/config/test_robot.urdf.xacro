<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="test_robot">
  <xacro:arg name="id2" default="0"/>
  <xacro:arg name="torque_on_startup" default="true"/>
  <xacro:arg name="velocity_limit" default="1.0"/>
  <xacro:arg name="current_limit" default="0"/>
  <link name="base_link"/>
  <joint name="joint_1" type="continuous">
    <parent link="base_link"/>
    <child link="link_1"/>
    <axis xyz="1 0 0" rpy="0 0 0"/>
    <limit effort="1000" velocity="1.5"/>
  </joint>
  <link name="link_1"/>
  <joint name="mimic_joint" type="continuous">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin rpy="0 0 0" xyz="0 0.008 0.048"/>
    <axis xyz="1 0 0"/>
    <limit effort="1000" velocity="1.5"/>
    <mimic joint="joint_1" multiplier="2" offset="1"/>
  </joint>
  <link name="link_2"/>
  <xacro:unless value="${$(arg id2) == 0}">
    <joint name="joint_2" type="continuous">
      <parent link="base_link"/>
      <child link="link_3"/>
      <origin rpy="0 0 0" xyz="0 0.1 0"/>
      <axis xyz="1 0 0" rpy="0 0 0"/>
      <limit effort="1000" velocity="1.5"/>
    </joint>
    <link name="link_3"/>
  </xacro:unless>
  <xacro:include filename="$(find dynamixel_ros_control)/config/ros2_control_test_config.xacro"/>
  <xacro:ros2_control_test_config port_name="$(arg port_name)" baud_rate="$(arg baud_rate)" id="$(arg id)" id2="$(arg id2)" torque_on_startup="$(arg torque_on_startup)" velocity_limit="$(arg velocity_limit)" current_limit="$(arg current_limit)"/>
</robot>
