<?xml version='1.0' encoding='UTF-8'?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dynamixel_ros_control</name>
  <version>0.0.0</version>
  <description>Provides a hardware interface for dynamixel motors.</description>
  <maintainer email="oehler@sim.tu-darmstadt.de">Martin Oehler</maintainer>
  <license>MIT</license>
  <author email="oehler@sim.tu-darmstadt.de">Martin Oehler</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>diagnostic_msgs</depend>
  <depend>dynamixel_sdk</depend>
  <depend>hardware_interface</depend>
  <depend>hector_transmission_interface</depend>
  <depend>hector_transmission_interface_msgs</depend>
  <depend>lifecycle_msgs</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>realtime_tools</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>transmission_interface</depend>
  <depend>yaml-cpp</depend>
  <depend>yaml_cpp_vendor</depend>

  <!-- Needed by the installed launch/ and config/ demo, not by the library. -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>forward_command_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_cmake_google_benchmark</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_ros</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <!-- The integration tests link against it, unlike the library itself. -->
  <test_depend>controller_manager</test_depend>
  <test_depend>hardware_contract_tests</test_depend>
  <test_depend>hector_controller_manager</test_depend>
  <test_depend>hector_testing_utils</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
